rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'alexrodrigues43@gmail.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isUserActive(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)) &&
        get(/databases/$(database)/documents/users/$(userId)).data.status == 'active';
    }

    function isValidDefinition(definitionId) {
      return request.resource.data.keys().hasAll(['id', 'entity', 'category', 'definition']) &&
        request.resource.data.id is string &&
        request.resource.data.id.size() > 0 &&
        request.resource.data.id == definitionId &&
        request.resource.data.entity is string &&
        request.resource.data.entity.size() > 0 &&
        request.resource.data.category is string &&
        request.resource.data.category.size() > 0 &&
        request.resource.data.definition is string &&
        request.resource.data.definition.size() > 0;
    }

    match /users/{userId} {
      // User can read their own profile, or Super Admin can read any
      allow get: if isOwner(userId) || isSuperAdmin();
      
      // Only Super Admin can list the users collection
      allow list: if isSuperAdmin();
      
      // Document creation:
      // Super admin can create any user profile.
      // Normal user can only create their own profile with role 'client' and status 'pending'.
      // If the email is the super admin email, they can register with admin and active status.
      allow create: if isAuthenticated() && isOwner(userId) && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'alexrodrigues43@gmail.com') ||
        (
          request.resource.data.role == 'client' &&
          request.resource.data.status == 'pending' &&
          request.resource.data.uid == request.auth.uid
        )
      );
      
      // Updates:
      // Super admin can update everything (role, status, plan, notes, etc.)
      // Normal user can only update safe fields (like toolUsageCount, displayName, lastLoginAt), never role, status, plan, or notes
      allow update: if isSuperAdmin() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'plan', 'notes'])
      );
      
      // Deletions: only super admin
      allow delete: if isSuperAdmin();
    }

    match /users/{userId}/definitions/{definitionId} {
      // Leitura (get, list)
      allow get, list: if isOwner(userId) || isSuperAdmin();

      // Criação (create)
      allow create: if ((isOwner(userId) && isUserActive(userId)) || isSuperAdmin()) && isValidDefinition(definitionId);

      // Atualização (update)
      allow update: if ((isOwner(userId) && isUserActive(userId)) || isSuperAdmin()) && isValidDefinition(definitionId);

      // Exclusão (delete)
      allow delete: if isOwner(userId) || isSuperAdmin();
    }
  }
}
